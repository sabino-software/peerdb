{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peerdb.io/schemas/plugin-manifest/v1alpha1.json",
  "title": "PeerDB connector plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "apiVersion", "kind", "metadata", "spec", "artifact"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "apiVersion": { "const": "peerdb.io/plugin/v1alpha1" },
    "kind": { "const": "ConnectorPlugin" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" },
    "artifact": { "$ref": "#/$defs/artifact" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "spec": {
            "properties": { "lifecycle": { "const": "planned" } },
            "required": ["lifecycle"]
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "properties": {
              "runtime": {
                "properties": { "entrypoint": { "type": "null" } }
              },
              "coreVersions": {
                "properties": {
                  "minimum": { "const": "0.0.0" },
                  "maximumExclusive": { "const": "0.0.0" }
                }
              },
              "dependencies": { "maxItems": 0 },
              "connectors": {
                "items": {
                  "properties": {
                    "capabilities": { "maxItems": 0 },
                    "recordFormats": { "maxItems": 0 },
                    "config": {
                      "properties": {
                        "schemaVersion": { "const": 0 },
                        "secretJsonPointers": { "maxItems": 0 },
                        "placeholder": { "const": true }
                      }
                    }
                  }
                }
              }
            }
          },
          "artifact": {
            "properties": {
              "status": { "const": "unbuilt" },
              "bundles": { "maxItems": 0 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "version", "description", "vendor", "homepage", "license"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
        },
        "displayName": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/semver" },
        "description": { "type": "string", "minLength": 1 },
        "vendor": { "type": "string", "minLength": 1 },
        "homepage": { "type": "string", "format": "uri" },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle", "protocol", "coreVersions", "runtime", "dependencies", "connectors"],
      "properties": {
        "lifecycle": {
          "enum": ["planned", "experimental", "beta", "stable", "deprecated"]
        },
        "protocol": { "$ref": "#/$defs/protocol" },
        "coreVersions": { "$ref": "#/$defs/coreVersions" },
        "runtime": { "$ref": "#/$defs/runtime" },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dependency" }
        },
        "connectors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/connector" }
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 1,
          "description": "Incompatible PeerDB plugin ABI generation."
        },
        "minor": {
          "type": "integer",
          "minimum": 0,
          "description": "Highest ABI minor this artifact is certified against; handshake may select an offered lower minor in the same major."
        }
      }
    },
    "coreVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximumExclusive"],
      "properties": {
        "minimum": { "$ref": "#/$defs/semver" },
        "maximumExclusive": { "$ref": "#/$defs/semver" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "entrypoint"],
      "properties": {
        "mode": { "const": "process" },
        "entrypoint": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "pattern": "^(?!.*\\.(?:so|dylib|dll)$)[A-Za-z0-9_./-]+$"
            }
          ]
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "versions"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
        },
        "versions": { "$ref": "#/$defs/coreVersions" }
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "description",
        "legacyDbTypes",
        "roles",
        "capabilities",
        "recordFormats",
        "stability",
        "config"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "legacyDbTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["source", "destination", "query"] }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        },
        "recordFormats": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["qvalue-proto-v1", "arrow-ipc-v1", "pg-text-v1", "pg-copy-v1", "object-ref-v1"]
          }
        },
        "stability": {
          "enum": ["experimental", "beta", "stable", "deprecated"]
        },
        "config": { "$ref": "#/$defs/config" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$",
          "description": "Capability identifiers are Core-owned; runnable v1alpha1 manifests must use the Core v1 registry."
        },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "uiHints", "schemaVersion", "secretJsonPointers", "placeholder"],
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^schemas/[A-Za-z0-9._-]+\\.schema\\.json$"
        },
        "uiHints": {
          "type": "string",
          "pattern": "^schemas/(?:[A-Za-z0-9._-]+\\.)?ui-hints\\.json$"
        },
        "schemaVersion": { "type": "integer", "minimum": 0 },
        "secretJsonPointers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/" }
        },
        "placeholder": { "type": "boolean" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "bundles"],
      "properties": {
        "status": { "enum": ["unbuilt", "built", "published"] },
        "bundles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "digest"],
            "properties": {
              "platform": { "type": "string", "pattern": "^[a-z0-9]+/[a-z0-9_]+$" },
              "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "unbuilt" } } },
          "then": { "properties": { "bundles": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "status": { "enum": ["built", "published"] } } },
          "then": { "properties": { "bundles": { "minItems": 1 } } }
        }
      ]
    }
  }
}
